  "narrative": {
    "northStar": "The personal workbench",
    "overview": "Stead uses warm neutral surfaces, deep olive controls, fine dividers and compact utility chrome. A restrained serif wordmark and conversational introductions provide identity; familiar system sans typography carries task and file content. The surface direction is recorded in `apps/client/.impeccable/surfaces/apps-client-src-app-workspace-tsx.md`.\n\nThis documents the implemented frontend. Tokens come from `packages/ui/src/theme.css`; shared controls come from `packages/ui/src/index.tsx`. Client styles and feature components supply layout and behavior. The interface ships no raster assets: its leaf mark and utility icons are SVG.",
    "keyCharacteristics": [
      "Warm neutral planes with olive actions.",
      "Serif introductions and compact sans utility text.",
      "Flat panels, fine dividers and modest rounded controls.",
      "Continuing conversation beside inspectable work."
    ],
    "rules": [],
    "dos": [
      "Do reuse the shared theme and control variants.",
      "Do pair status color with readable labels and retain separate connection and task states.",
      "Do preserve the mounted conversation while navigating work and files.",
      "Do use the existing focus treatment and reduced-motion behavior."
    ],
    "donts": [
      "Don't turn reply completion or connection health into a completed-task signal.",
      "Don't replace explicit task resume with automatic resume when the workspace opens.",
      "Don't introduce a second visual system for notes, files or task controls."
    ]
  }
